PORT=4100
NODE_ENV=production
ALLOWED_ORIGINS=https://ask.ofrc-admin.com

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=chatbot
DB_USER=ofrc_app
DB_PASSWORD=REPLACE_ME

UPLOAD_DIR=/var/www/ofrc/chatbot/uploads
UPLOAD_MAX_BYTES=26214400

# Embeddings use the shared Ollama container on the ofrc_ollama network.
OLLAMA_BASE_URL=http://ofrc-ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat and topic extraction. Set the key only in the gitignored env file.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=30
RECOVERY_USERNAME=recovery
RECOVERY_PASSWORD=REPLACE_ME

CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

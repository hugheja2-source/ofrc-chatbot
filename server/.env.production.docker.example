PORT=4100
NODE_ENV=production
ALLOWED_ORIGINS=https://chat.ofrc-admin.com

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=chatbot_production
DB_USER=ofrc_app
DB_PASSWORD=REPLACE_ME

UPLOAD_DIR=/var/www/ofrc/chatbot/production/uploads
UPLOAD_MAX_BYTES=26214400

# Hostname is the shared Ollama container on the ofrc_ollama network.
OLLAMA_BASE_URL=http://ofrc-ollama:11434
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096

BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=30
RECOVERY_USERNAME=recovery
RECOVERY_PASSWORD=REPLACE_ME

CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

{
	auto_https off
}

http://chat.ofrc-admin.com {
	encode gzip zstd
	reverse_proxy frontend:80
}

http://api-chat.ofrc-admin.com {
	request_body {
		max_size 30MB
	}
	reverse_proxy api:4100 {
		flush_interval -1
		transport http {
			response_header_timeout 180s
			read_timeout 180s
			write_timeout 180s
		}
	}
}
